#### Editor de setores
270 X=USR2(0):GOSUB 30:PRINT @583,DR;@592,TR;@601,SE;"  ";
280 V1=15401:L=0:C=0:PP=15401:Q=PEEK(PP)
290 PK=14440
300 P=PEEK(PK):POKE PP,Q:POKE PP,191
310 IF P=8 THEN 400
320 IF P=16 THEN 410
330 IF P=1 THEN 420
340 IF P=64 THEN 450
350 IF P=2 THEN 480
360 IF P=128 THEN POKE PP,Q:GOTO 690
370 POKE PP,Q:PP=V1+(L*16)+C:Q=PEEK(PP):POKE PP,191
380 PRINT @775,L*16+C;" ";@780,Q;" "
390 GOTO 300
400 IF L<1 THEN 370 ELSE L=L-1:GOTO 370
410 IF L>14 THEN 290 ELSE L=L+1:GOTO 370
420 IF C<1 AND L<1 THEN 370
430 IF C<1 AND L>0 THEN L=L-1:C=15:GOTO 370
440 C=C-1:GOTO 370
450 IF C>14 AND L>14 THEN 370
460 IF C>14 AND L<15 THEN L=L+1:C=0:GOTO 370
