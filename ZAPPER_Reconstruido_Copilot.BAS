#### Modos DEC e ASC
480 IF M=1 THEN 500 ELSEIF M=2 THEN 510
490 PRINT @899,"Valor Decimal:";
    :A(2)=914:A(1)=3:A(3)=1
    :GOSUB 550
    :NV=VAL(A$(1))
    :IF NV>255 THEN 490 ELSE POKE 32256+(L*16)+C,NV
    :Q=NV:PRINT @899,STRING$(19,32);
    :POKEPP,Q
    :GOTO 450
500 A(3)=0
    :PRINT @899,"Conteudo Ascii:";
    :A(2)=915:A(1)=1:A(3)=2
    :GOSUB 550
    :IF A$(1)="" THEN 500 ELSE NV=ASC(A$(1))
    :POKE 32256+(L*16)+C,NV
    :Q=NV
    :PRINT @899,STRING$(18,32);
    :POKEPP,Q:GOTO 450

#### Modo GRA
510 PRINT @899,"Use as teclas: 8 9 5 6 2 3";
    :GM$="895623"+CHR$(13)
    :POKEPP,191
    :G$=CHR$(191)
    :G=191
520 GR$=INKEY$
    :IF GR$="" THEN 520 ELSE B=INSTR(GM$,GR$)
    :IF B=0 THEN 520 ELSE IF B=7 THEN 540 ELSE B=B-1
    :IF G AND 2^(B) THEN G1$=CHR$(ASC(G$)ANDNOT2^(B)) ELSE G1$=CHR$(ASC(G$)OR2^(B))
530 POKEPP,ASC(G1$)
    :G$=G1$:G=ASC(G$)
    :GOTO 520
540 NV=ASC(G$)
    :POKE 32256+(L*16)+C,NV
    :Q=NV
    :PRINT @899,STRING$(31,32);
    :POKEPP,Q:GOTO 450

#### Entrada genérica
550 A(4)=0:A(5)=0:A$(1)=""
    :A(6)=0:A(7)=0
560 PRINT @A(2),STRING$(A(1),46);
    :@A(2)-1,CHR$(62);
570 A$(2)=INKEY$
    :IF A$(2)="" THEN 570 ELSE A(6)=ASC(A$(2))
    :IF A(6)=13 THEN 580 ELSE IF A(6)=8 THEN 
        IF A(4)=0 THEN 570 ELSE 590 ELSE 600
580 PRINT @A(2)+A(4),STRING$(A(1)-A(4),32);
    :@A(2)-1," ";
    :RETURN
590 PRINT @A(2)+A(4),CHR$(8)CHR$(46);
    :A(4)=A(4)-1
    :A$(1)=LEFT$(A$(1),A(4))
    :GOTO 570
600 IF A(4)=A(1) THEN 570
610 IF A(3)<>1 THEN 620 ELSE 
        IF A(6)>=48 AND A(6)<=57 THEN 630 ELSE 
            IF A(6)=46 AND A(8)=0 THEN A(8)=1
                :GOTO 630 ELSE 570
620 IF A(6)=64 THEN GOTO 570 ELSE 
        IF A(3)=2 AND (A(6)<33 OR A(6)>90) THEN A(9)=0:GOTO 630 ELSE 
            IF A(6)=32 AND A(3)=2 AND A(9)=0 THEN A(9)=1:GOTO 630 ELSE 570
630 PRINT @A(2)+A(4),A$(2)
    :A$(1)=A$(1)+A$(2)
    :A(4)=A(4)+1
    :A(5)=1
    :GOTO 570

